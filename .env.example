# ── Zeminent webinar app ────────────────────────────────────────────────────
#
# Every variable here is optional: app/webinar/config.js carries a committed
# default for each, so `npm run dev` works on a fresh clone with no .env file.
# Set them in staging/production.
#
# All are NEXT_PUBLIC_ because this app runs entirely in the browser — it has
# no server-side data access, no database, and no calls to the Zeminent
# backend. Do not put secrets here; anything with this prefix is compiled into
# the client bundle and is readable by any visitor.
#
# Full go-live checklist: README.md

# ── Cross-app links ─────────────────────────────────────────────────────────

# The main Zeminent learner site. Drives "← Back to Zeminent" in the top bar,
# every footer link, and the two thank-you page buttons. Without it those
# links point at production while you develop locally.
#   dev:  http://localhost:7000
NEXT_PUBLIC_ZEMINENT_URL=

# This app's own public origin. Used for the canonical URL, the Open Graph /
# Twitter card image URLs, and the Event JSON-LD. Wrong value here means
# social previews resolve against the wrong host.
# Defaults to https://webinar.zeminent.com.
#   dev:  http://localhost:7002
NEXT_PUBLIC_WEBINAR_SITE_URL=

# Backend API, including the /api suffix. Used server-side to fetch the
# published session (`GET /webinars/current`) and as the CSP img-src origin
# for instructor photos. The backend listens on 7002, not 4000.
#   prod: https://admin.learning.zeminent.com/api
#   dev:  http://localhost:7002/api
API_URL=

# ── Zoho ────────────────────────────────────────────────────────────────────

# Zoho Forms permalink (Zoho Forms → Share → Permalink). The registration
# modal frames this URL and appends the UTM fields as query params.
NEXT_PUBLIC_ZOHO_FORM_URL=

# Zoho Webinar session registration / joining URL, surfaced on the thank-you
# page as the primary action.
NEXT_PUBLIC_WEBINAR_URL=

# ── Session ─────────────────────────────────────────────────────────────────

# Session start, ISO 8601 with an explicit offset. IST is +05:30. Must match
# the session created in Zoho Webinar. One value drives the landing page's
# countdown, the thank-you panel and the calendar file.
#   NEXT_PUBLIC_WEBINAR_START=2026-08-16T11:00:00+05:30
NEXT_PUBLIC_WEBINAR_START=
NEXT_PUBLIC_WEBINAR_DURATION_MINUTES=

# ── Analytics ───────────────────────────────────────────────────────────────

# GA4 Measurement ID. Defaults to the live Zeminent property (G-D4XJJ21J86)
# in app/webinar/config.js, so analytics works with no .env file at all.
#
# Set this to point a deployment at a different property — a staging one, say.
# Setting it to anything that isn't a valid G-XXXXXXXX id (including a
# placeholder) switches the tag off entirely, which is the way to stop local
# development polluting production reports.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
